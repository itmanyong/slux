{
  "name": "@slux/website",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "pnpm docs:examples && rs doc",
    "docs:build": "pnpm docs:examples && rs doc build",
    "docs:examples": "pnpm --dir ../.. exec turbo run build --filter=@slux/example-* --filter=@slux/gallery-example && node ./scripts/copy-examples.mjs && node ./scripts/copy-examples.test.mjs",
    "docs:preview": "rs doc preview"
  },
  "devDependencies": {
    "@rspress/core": "catalog:",
    "@rspress/plugin-playground": "2.1.1",
    "@rspress/plugin-preview": "2.1.1",
    "@slux/core": "workspace:*",
    "@types/react": "catalog:",
    "limu": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rspress-plugin-mermaid": "2.0.0",
    "rspress-plugin-reading-time": "1.0.2",
    "rstack": "catalog:",
    "typescript": "6.0.3"
  }
}
