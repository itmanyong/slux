{
  "name": "@slux/rxjs",
  "version": "0.3.0",
  "description": "slux 与 RxJS 的双向桥接",
  "keywords": [
    "slux",
    "rxjs",
    "observable",
    "reactive"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://github.com/itmanyong/slux/tree/main/packages/rxjs#readme",
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/slux.git",
    "directory": "packages/rxjs"
  },
  "bugs": {
    "url": "https://github.com/itmanyong/slux/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "rs lib -w",
    "build": "rs lib",
    "test": "rs test",
    "lint": "rs lint",
    "fmt": "rs fmt",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for(const p of ['dist','.turbo','node_modules'])require('node:fs').rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@slux/core": "workspace:*",
    "@slux/shared": "workspace:*"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "rxjs": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:"
  }
}
