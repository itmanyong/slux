{
  "name": "@slux/actview",
  "version": "0.2.4",
  "description": "为 ActView 提供的 slux 框架绑定",
  "keywords": [
    "slux",
    "actview",
    "bindings",
    "state-management"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://github.com/itmanyong/slux/tree/main/packages/actview#readme",
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/slux.git",
    "directory": "packages/actview"
  },
  "bugs": {
    "url": "https://github.com/itmanyong/slux/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./atom": {
      "import": {
        "types": "./dist/atom.d.ts",
        "default": "./dist/atom.js"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store.d.ts",
        "default": "./dist/store.js"
      }
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      }
    },
    "./package.json": "./package.json",
    "./flux": {
      "import": {
        "types": "./dist/flux.d.ts",
        "default": "./dist/flux.js"
      }
    },
    "./state-machine": {
      "import": {
        "types": "./dist/state-machine.d.ts",
        "default": "./dist/state-machine.js"
      }
    },
    "./rxjs": {
      "import": {
        "types": "./dist/rxjs.d.ts",
        "default": "./dist/rxjs.js"
      }
    }
  },
  "scripts": {
    "dev": "rs lib -w",
    "build": "rs lib",
    "test": "rs test",
    "lint": "rs lint",
    "fmt": "rs fmt",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for(const p of ['dist','.turbo'])require('node:fs').rmSync(p,{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@slux/atom": "workspace:^",
    "@slux/core": "workspace:^",
    "@slux/proxy": "workspace:^",
    "@slux/store": "workspace:^",
    "@actview/core": ">=1.0.0",
    "@slux/flux": "workspace:^",
    "@slux/state-machine": "workspace:^",
    "@slux/rxjs": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@slux/atom": {
      "optional": true
    },
    "@slux/proxy": {
      "optional": true
    },
    "@slux/store": {
      "optional": true
    },
    "@slux/flux": {
      "optional": true
    },
    "@slux/state-machine": {
      "optional": true
    },
    "@slux/rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slux/atom": "workspace:*",
    "@slux/core": "workspace:*",
    "@slux/proxy": "workspace:*",
    "@slux/store": "workspace:*",
    "jsdom": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:",
    "@actview/core": "catalog:",
    "actview": "catalog:",
    "@actview/jsx": "catalog:",
    "@slux/flux": "workspace:*",
    "@slux/state-machine": "workspace:*",
    "@slux/rxjs": "workspace:*",
    "rxjs": "catalog:"
  },
  "dependencies": {
    "@slux/shared": "workspace:*"
  }
}
