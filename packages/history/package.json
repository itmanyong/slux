{
  "name": "@slux/history",
  "version": "0.2.1",
  "description": "基于 Store 快照的撤销与重做中间件",
  "sideEffects": false,
  "keywords": [
    "slux",
    "undo",
    "redo",
    "middleware"
  ],
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/@slux/history",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/slux.git",
    "directory": "packages/history"
  },
  "bugs": {
    "url": "https://github.com/itmanyong/slux/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "rs lib -w",
    "build": "rs lib",
    "test": "rs test",
    "lint": "rs lint",
    "fmt": "rs fmt",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@slux/core": "workspace:*",
    "@slux/store": "workspace:*",
    "@slux/shared": "workspace:*"
  },
  "devDependencies": {
    "@slux/devtools": "workspace:*",
    "@slux/storage": "workspace:*",
    "@slux/tab-sync": "workspace:*",
    "@slux/telemetry": "workspace:*",
    "rstack": "catalog:",
    "typescript": "catalog:"
  }
}
