{
  "name": "@slux/ripple",
  "version": "0.3.0",
  "description": "为 Ripple 提供的 slux 框架绑定",
  "keywords": [
    "slux",
    "ripple",
    "bindings",
    "state-management"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://github.com/itmanyong/slux/tree/main/packages/ripple#readme",
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/slux.git",
    "directory": "packages/ripple"
  },
  "bugs": {
    "url": "https://github.com/itmanyong/slux/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/server.js",
  "module": "./dist/index.js",
  "types": "./dist/root.d.ts",
  "exports": {
    ".": {
      "types": "./dist/root.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/server.js"
    },
    "./atom": {
      "types": "./dist/atom.d.ts",
      "default": "./dist/atom.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./flux": {
      "types": "./dist/flux.d.ts",
      "default": "./dist/flux.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine.d.ts",
      "default": "./dist/state-machine.js"
    },
    "./rxjs": {
      "types": "./dist/rxjs.d.ts",
      "default": "./dist/rxjs.js"
    }
  },
  "scripts": {
    "dev": "rs lib -w",
    "build": "rs lib",
    "test": "rs test",
    "lint": "rs lint",
    "fmt": "rs fmt",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "clean": "node -e \"for(const p of ['dist','.turbo','node_modules'])require('node:fs').rmSync(p,{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@slux/atom": "workspace:^",
    "@slux/core": "workspace:^",
    "@slux/proxy": "workspace:^",
    "@slux/store": "workspace:^",
    "ripple": ">=0.6.0",
    "@slux/flux": "workspace:^",
    "@slux/state-machine": "workspace:^",
    "@slux/rxjs": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@slux/atom": {
      "optional": true
    },
    "@slux/proxy": {
      "optional": true
    },
    "@slux/store": {
      "optional": true
    },
    "@slux/flux": {
      "optional": true
    },
    "@slux/state-machine": {
      "optional": true
    },
    "@slux/rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slux/atom": "workspace:*",
    "@slux/core": "workspace:*",
    "@slux/proxy": "workspace:*",
    "@slux/store": "workspace:*",
    "jsdom": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:",
    "ripple": "catalog:",
    "@slux/flux": "workspace:*",
    "@slux/state-machine": "workspace:*",
    "@slux/rxjs": "workspace:*",
    "rxjs": "catalog:"
  },
  "dependencies": {
    "@slux/shared": "workspace:*"
  }
}
