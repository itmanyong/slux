{
  "name": "slux",
  "description": "slux 是一组以框架无关的响应式核心为基础的 TypeScript 状态管理包",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/slux.git"
  },
  "homepage": "https://github.com/itmanyong/slux#readme",
  "bugs": {
    "url": "https://github.com/itmanyong/slux/issues"
  },
  "author": "itmanyong <itmanyong@gmail.com>",
  "keywords": [
    "slux",
    "state-management",
    "reactive",
    "signals",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --concurrency=32",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && rs lint scripts",
    "lint:fix": "rs lint --fix .",
    "format": "turbo run fmt",
    "format:check": "rs fmt --check .",
    "typecheck": "turbo run typecheck",
    "prepare": "simple-git-hooks",
    "changeset": "changeset",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "version:packages": "node scripts/version-packages.mjs",
    "changelog:generate": "node scripts/generate-changelogs.mjs",
    "release": "node scripts/release.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "docs:dev": "turbo run docs:dev",
    "docs:build": "turbo run docs:build",
    "docs:preview": "turbo run docs:preview",
    "examples:dev": "node scripts/run-examples.mjs",
    "generate:apis": "node scripts/generate-import-apis.mjs",
    "sync:package-navigation": "node scripts/sync-package-navigation.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "rstack": "catalog:",
    "simple-git-hooks": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged --concurrent false --max-arg-length 3000"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "rs lint --fix",
      "rs fmt --write --ignore-path examples/vue-rsbuild-ts/.gitignore --ignore-path examples/svelte-rsbuild-ts/.gitignore --no-error-on-unmatched-pattern"
    ],
    "*.{css,html,vue,json,md,mdx,yml,yaml}": [
      "rs fmt --write"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "volta": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
