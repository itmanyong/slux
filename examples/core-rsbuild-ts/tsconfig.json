{
  "compilerOptions": {
    "rootDir": "../..",
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "verbatimModuleSyntax": true
  },
  "include": ["src", "__tests__", "rstack.config.ts"]
}
