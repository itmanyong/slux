{
  "compilerOptions": {
    "rootDir": "../..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@viewfly/core",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "__tests__", "vite.config.ts"]
}
